needsPackage "NumericalAlgebraicGeometry";

-----------------------------------------------------------------------------
-- Small exact examples with explicitly known linear slices
-----------------------------------------------------------------------------

-- Every entry in toyExamples has the same fields:
--   n, d                 ambient dimension and dimension of the ideal
--   Ring, Ideal          a polynomial ring and an ideal over QQ
--   Hyperplanes          an ideal generated by exactly d rational hyperplanes
--   KnownSolutionCoordinates / KnownSolutions
--                        all points in V(I + Hyperplanes), at high precision
--   KnownSolutionDescriptions
--                        exact, human-readable coordinates for those points
--   WitnessSet           the corresponding numerical witness set

ToyExamplesCC = CC_300;

toyPoint = coordinatesList -> point {apply(coordinatesList, z ->
    if ring z === ToyExamplesCC then z else promote(z,ToyExamplesCC))};

toyExample = (name,n,d,R,I,H,coordinatesList,descriptions) -> (
    solutionPoints := apply(coordinatesList, toyPoint);
    new HashTable from {
        "Name" => name,
        "n" => n,
        "d" => d,
        "Ring" => R,
        "Ideal" => I,
        "Hyperplanes" => H,
        "SliceIdeal" => I + H,
        "KnownSolutionCoordinates" => coordinatesList,
        "KnownSolutionDescriptions" => descriptions,
        "KnownSolutions" => solutionPoints,
        "WitnessSet" => witnessSet(I,H,solutionPoints)
        }
    );

-----------------------------------------------------------------------------
-- (n,d) = (2,1): a nodal cubic with a rational three-point slice
-----------------------------------------------------------------------------

NodalCubicToyRing = QQ[nodalX,nodalY];
NodalCubicToyIdeal = ideal(nodalY^2-nodalX^2*(nodalX+1));
NodalCubicToyHyperplanes = ideal(5*nodalY-18*nodalX+24);
NodalCubicToyKnownSolutionCoordinates = {
    {3_QQ,6_QQ},
    {8_QQ,24_QQ},
    {24/25,-168/125}
    };
NodalCubicToy = toyExample(
    "nodal-cubic-rational-slice",2,1,NodalCubicToyRing,
    NodalCubicToyIdeal,NodalCubicToyHyperplanes,
    NodalCubicToyKnownSolutionCoordinates,
    {"(3, 6)","(8, 24)","(24/25, -168/125)"});
declareIrreducible(NodalCubicToy#"WitnessSet");

-----------------------------------------------------------------------------
-- (n,d) = (2,1): a parabola sliced at y=-2
-- The restricted equation is x^2+2=0.
-----------------------------------------------------------------------------

ToySqrtMinusTwo = sqrt(promote(-2,ToyExamplesCC));
IrrationalParabolaRing = QQ[parabolaX,parabolaY];
IrrationalParabolaIdeal = ideal(parabolaY-parabolaX^2);
IrrationalParabolaHyperplanes = ideal(parabolaY+2);
IrrationalParabolaKnownSolutionCoordinates = {
    {ToySqrtMinusTwo,-2_QQ},
    {-ToySqrtMinusTwo,-2_QQ}
    };
IrrationalParabola = toyExample(
    "parabola-x2-plus-2",2,1,IrrationalParabolaRing,
    IrrationalParabolaIdeal,IrrationalParabolaHyperplanes,
    IrrationalParabolaKnownSolutionCoordinates,
    {"(sqrt(-2), -2)","(-sqrt(-2), -2)"});
declareIrreducible(IrrationalParabola#"WitnessSet");

-----------------------------------------------------------------------------
-- (n,d) = (3,1): two parallel affine lines, sliced at z=5
-----------------------------------------------------------------------------

TwoIrrationalLinesRing = QQ[lineX,lineY,lineZ];
TwoIrrationalLinesIdeal = ideal(lineX^2+2,lineY-3);
TwoIrrationalLinesHyperplanes = ideal(lineZ-5);
TwoIrrationalLinesKnownSolutionCoordinates = {
    {ToySqrtMinusTwo,3_QQ,5_QQ},
    {-ToySqrtMinusTwo,3_QQ,5_QQ}
    };
TwoIrrationalLines = toyExample(
    "two-irrational-lines",3,1,TwoIrrationalLinesRing,
    TwoIrrationalLinesIdeal,TwoIrrationalLinesHyperplanes,
    TwoIrrationalLinesKnownSolutionCoordinates,
    {"(sqrt(-2), 3, 5)","(-sqrt(-2), 3, 5)"});

-----------------------------------------------------------------------------
-- (n,d) = (3,2): a quadratic surface sliced by x=y=0
-----------------------------------------------------------------------------

QuadraticSurfaceRing = QQ[surfaceX,surfaceY,surfaceZ];
QuadraticSurfaceIdeal = ideal(surfaceZ^2+surfaceX+2);
QuadraticSurfaceHyperplanes = ideal(surfaceX,surfaceY);
QuadraticSurfaceKnownSolutionCoordinates = {
    {0_QQ,0_QQ,ToySqrtMinusTwo},
    {0_QQ,0_QQ,-ToySqrtMinusTwo}
    };
QuadraticSurface = toyExample(
    "quadratic-surface",3,2,QuadraticSurfaceRing,
    QuadraticSurfaceIdeal,QuadraticSurfaceHyperplanes,
    QuadraticSurfaceKnownSolutionCoordinates,
    {"(0, 0, sqrt(-2))","(0, 0, -sqrt(-2))"});
declareIrreducible(QuadraticSurface#"WitnessSet");

-----------------------------------------------------------------------------
-- (n,d) = (4,2): the product of two parabolas
-- The slice gives a^2+2=0 and b^2-3=0, hence four irrational points.
-----------------------------------------------------------------------------

ToySqrtThree = sqrt(promote(3,ToyExamplesCC));
ProductOfParabolasRing = QQ[productA,productB,productC,productD];
ProductOfParabolasIdeal = ideal(
    productC-productA^2,
    productD-productB^2);
ProductOfParabolasHyperplanes = ideal(productC+2,productD-3);
ProductOfParabolasKnownSolutionCoordinates = flatten apply(
    {ToySqrtMinusTwo,-ToySqrtMinusTwo}, a -> apply(
        {ToySqrtThree,-ToySqrtThree}, b -> {a,b,-2_QQ,3_QQ}));
ProductOfParabolas = toyExample(
    "product-of-parabolas",4,2,ProductOfParabolasRing,
    ProductOfParabolasIdeal,ProductOfParabolasHyperplanes,
    ProductOfParabolasKnownSolutionCoordinates,
    {
        "(sqrt(-2), sqrt(3), -2, 3)",
        "(sqrt(-2), -sqrt(3), -2, 3)",
        "(-sqrt(-2), sqrt(3), -2, 3)",
        "(-sqrt(-2), -sqrt(3), -2, 3)"
        });
declareIrreducible(ProductOfParabolas#"WitnessSet");

toyExampleNames = {
    "nodal-cubic-rational-slice",
    "parabola-x2-plus-2",
    "two-irrational-lines",
    "quadratic-surface",
    "product-of-parabolas"
    };

toyExamples = new HashTable from {
    "nodal-cubic-rational-slice" => NodalCubicToy,
    "parabola-x2-plus-2" => IrrationalParabola,
    "two-irrational-lines" => TwoIrrationalLines,
    "quadratic-surface" => QuadraticSurface,
    "product-of-parabolas" => ProductOfParabolas
    };

